{
  // Ajustes solo de este proyecto; los tuyos (tema, fuente, atajos) no cambian

  // Usar el Python de la .venv del proyecto
  // En Windows elígelo una vez con "Python: Select Interpreter": .venv\Scripts\python.exe
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,

  // La terminal carga las variables del .env
  "python.terminal.useEnvFile": true,
  "python.envFile": "${workspaceFolder}/.env",

  // Para que el editor encuentre app, config y utils, y el conftest de las pruebas
  // (el primero lo usa Pylance y el segundo basedpyright; cada uno lee el suyo)
  "python.analysis.extraPaths": ["${workspaceFolder}", "${workspaceFolder}/tests"],
  "basedpyright.analysis.extraPaths": ["${workspaceFolder}", "${workspaceFolder}/tests"],

  // Las pruebas se ven y se corren desde la pestaña Testing
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // Al guardar, ruff ordena los imports y da formato, igual que revisa GitHub
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit",
      "source.fixAll.ruff": "explicit"
    }
  },

  // Mismo formato de archivo en Windows, Mac y Linux
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  // Ocultar carpetas que se generan solas
  "files.exclude": {
    "**/__pycache__": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true
  },

  // No buscar en la .venv, en los CSV guardados ni en los JSON grandes del modelo
  "search.exclude": {
    "**/.venv": true,
    "storage": true,
    "ml/artifacts/*.json": true
  }
}
