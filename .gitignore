# Entorno local y secretos: nunca se suben
.venv/
.env
.env.*
# La plantilla sí se sube, para saber qué variables hay que definir
!.env.example

# Artefactos del modelo: se ignora todo menos lo que la API usa
ml/artifacts/*
!ml/artifacts/pipeline.joblib
!ml/artifacts/metrics.json
!ml/artifacts/experiments.json
!ml/artifacts/dataset_profile.json
!ml/artifacts/sample.csv

# Archivos que Python y las herramientas generan solos
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/

# Editor: de .vscode solo se sube la configuración del proyecto,
# lo demás es de cada persona
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# CSV de lotes guardados en local
storage/
