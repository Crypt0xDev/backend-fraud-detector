# --- API ---
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
WEB_CONCURRENCY=1
LOG_LEVEL=INFO
DOCS_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_IP=60
TRUSTED_PROXIES=127.0.0.1,::1

# --- Modelo ---
ARTIFACTS_DIR=ml/artifacts
MODEL_SHA256=
MODEL_THREADS=1
FRAUD_THRESHOLD=

# --- Lotes ---
MAX_BATCH_ROWS=10000
MAX_PREDICT_ROWS=100
MAX_UPLOAD_MB=20

# --- Base de datos ---
DATABASE_URL=
DB_POOL_SIZE=5

# --- Almacenamiento de CSV ---
STORAGE_BACKEND=local
STORAGE_DIR=storage
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=batches

# --- Auth ---
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# --- Admin inicial (solo si no hay ningún root) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=