# --- API ---
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
WEB_CONCURRENCY=1
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_IP=60

# --- Modelo ---
ARTIFACTS_DIR=ml/artifacts
MODEL_SHA256=
MODEL_THREADS=1
FRAUD_THRESHOLD=

# --- Lotes ---
MAX_BATCH_ROWS=10000
MAX_UPLOAD_MB=20

# --- Base de datos ---
DATABASE_URL=
DB_POOL_SIZE=5

# --- Almacenamiento de CSV ---
STORAGE_BACKEND=local
STORAGE_DIR=storage
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=batches

# --- Auth ---
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# --- Usuarios iniciales ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
USER_USERNAME=
USER_PASSWORD=
