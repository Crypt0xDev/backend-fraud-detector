# Orígenes permitidos por CORS
CORS_ORIGINS=http://localhost:3000

# Ruta del pipeline entrenado
MODEL_PATH=ml/artifacts/pipeline.joblib

# Ruta de las métricas del entrenamiento
METRICS_PATH=ml/artifacts/metrics.json

# Muestra para la vista 3D, comparación de modelos y perfil del dataset (de ml-fraud-training)
SAMPLE_PATH=ml/artifacts/sample.csv
EXPERIMENTS_PATH=ml/artifacts/experiments.json
PROFILE_PATH=ml/artifacts/dataset_profile.json

# SHA-256
MODEL_SHA256=

# Máximo de filas aceptadas en una sola petición
MAX_BATCH_ROWS=10000

# Tamaño máximo del CSV en MB
MAX_UPLOAD_MB=20

# PostgreSQL de Supabase (Transaction pooler)
DATABASE_URL=

# Almacenamiento de los CSV de los lotes: local o supabase
STORAGE_BACKEND=local
STORAGE_DIR=storage

# URL pública de esta API (se muestra en el resumen de arranque)
API_PUBLIC_URL=http://localhost:8000

# Supabase Storage (solo con STORAGE_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=batches

# Clave para firmar los JWT
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Duración de la sesión en minutos
JWT_EXPIRE_MINUTES=480

# Usuario administrador (opcional): se crea al arrancar si no existe
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Usuario normal (opcional): se crea al arrancar si no existe
USER_USERNAME=
USER_PASSWORD=

# Umbral de alerta. Vacío: se usa el de metrics.json (elegido en validación)
FRAUD_THRESHOLD=

# Predicciones por minuto y usuario (0 = sin límite)
RATE_LIMIT_PER_MINUTE=120

# Nivel de log: DEBUG, INFO, WARNING o ERROR
LOG_LEVEL=INFO
