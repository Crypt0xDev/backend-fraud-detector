# Orígenes permitidos por CORS
CORS_ORIGINS=http://localhost:3000

# Ruta del pipeline entrenado
MODEL_PATH=ml/artifacts/pipeline.joblib

# Ruta de las métricas del entrenamiento
METRICS_PATH=ml/artifacts/metrics.json

# SHA-256 esperado de pipeline.joblib (opcional). Si no coincide, el modelo no se carga
MODEL_SHA256=

# Máximo de filas aceptadas en una sola petición
MAX_BATCH_ROWS=10000

# Probabilidad a partir de la cual una transacción se marca como fraude
FRAUD_THRESHOLD=0.5

# Nivel de log: DEBUG, INFO, WARNING o ERROR
LOG_LEVEL=INFO
